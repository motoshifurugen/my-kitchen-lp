---
import { cta, hero, devStory } from "../constants/content";
import FaqSection from "./FaqSection.astro";
import StoreBadgeGroup from "./StoreBadgeGroup.astro";
import PageSection from "./PageSection.astro";

let likeCount: number | null = null;
try {
  const res = await fetch("https://note.com/api/v3/notes/ne23fa9c681d0");
  const json = await res.json();
  likeCount = json?.data?.like_count ?? null;
} catch {
  // ビルド時に取得できない場合は非表示
}
---
<PageSection
  id={cta.id}
  page={cta.eyebrow}
  title={cta.title}
>
  <div class="space-y-lg">
    <div class="space-y-xs">
      <p class="book-label">{devStory.eyebrow}</p>
      <a
        href={devStory.url}
        target="_blank"
        rel="noopener noreferrer"
        class="section-frame section-shadow flex flex-col sm:flex-row gap-md p-md rounded-xl overflow-hidden no-underline hover:no-underline"
      >
        <img
          src={devStory.thumbnail}
          alt={devStory.title}
          loading="lazy"
          class="w-full sm:w-36 h-24 sm:h-auto object-cover rounded-lg flex-shrink-0"
        />
        <div class="flex flex-col justify-between gap-xs">
          <div class="space-y-xs">
            <p class="text-caption font-medium leading-snug">{devStory.title}</p>
            <p class="text-sm text-text-secondary line-clamp-2">{devStory.description}</p>
          </div>
          <div class="flex items-center gap-xs">
            <span class="text-caption text-text-tertiary">{devStory.source}</span>
            {likeCount !== null && (
              <span class="inline-flex items-end gap-[3px] text-xs font-sans" style="color: #e07070;" aria-label="スキの数">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mb-[2px]" aria-hidden="true">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
                <span class="tabular-nums">{likeCount}</span>
              </span>
            )}
          </div>
        </div>
      </a>
    </div>
    <div class="space-y-sm">
      <StoreBadgeGroup />
      <div class="flex flex-wrap gap-sm">
        {hero.announceLinks.map((link) => (
          <a
            class="section-frame section-shadow inline-flex h-10 w-10 items-center justify-center rounded-md bg-background-secondary"
            href={link.href}
            aria-label={link.label}
          >
            <img class="h-4 w-4" src={link.iconSrc} alt={link.iconAlt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
    <div class="space-y-sm text-caption text-text-secondary">
      <div>
        <a href={cta.contact.href}>{cta.contact.label}</a>
      </div>
      <div class="flex flex-wrap gap-md">
        {cta.legal.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</PageSection>
